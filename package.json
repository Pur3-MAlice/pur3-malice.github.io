{
  "name": "wedding-site",
  "version": "1.0.0",
  "scripts": {
    "dev": "live-server --watch=src",
    "build:scss": "sass src/scss/style.scss style.css --no-source-map --style=compressed",
    "build:css": "tailwindcss -i src/tailwind/input.css -o tailwind.css --minify",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "sass": "^1.69.0",
    "concurrently": "^8.2.2",
    "imagemin": "^8.0.1",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^9.0.0"
  }
}
